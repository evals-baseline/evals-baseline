# Copy this file to .env and fill in the values. .env is ignored by git and must never be committed.
# Every key here must also exist in .env, and every key in .env must exist here. The workspace skill
# keep-env-and-example-in-step.md says how that is checked.

# Slack incoming webhook for the #critical channel. Used by the investigation reminder to tell the
# owner that a pain investigation is due. A webhook URL is a credential: anyone holding it can post
# to that channel. It is stored as the organisation secret CRITICAL_SLACK_WEBHOOKS_URL, visible to
# every repository in the evals-baseline organisation, never as a repository variable.
CRITICAL_SLACK_WEBHOOKS_URL=

# npm automation token for publishing the package. Create it at npmjs.com under Access Tokens.
# It is a credential: whoever holds it can publish under your name. Stored as the organisation
# secret NPMJS_TOKEN. Never pass it through a shell variable; write it into a temporary .npmrc and
# delete the file, or let the workflow read it from the secret.
# The token issued on 2026-11-15 was exposed in a session transcript on 2026-11-16 and must not be
# reused. A replacement should be granular, limited to the evals-baseline package, not read and
# write to every package.
NPMJS_TOKEN=npm_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
